{
  "mcpServers": {
    "astryx": {
      "type": "stdio",
      "command": "node",
      "args": ["${ZCODE_PLUGIN_ROOT}/mcp/server.mjs"],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "ASTRYX_CLI_VERSION": "0.7.14"
      },
      "enabled": true,
      "timeoutMs": 180000
    }
  }
}
